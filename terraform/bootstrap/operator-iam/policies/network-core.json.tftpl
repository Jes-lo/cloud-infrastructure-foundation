{"Version":"2012-10-17","Statement":[{"Sid":"CreateTaggedDevelopmentVpc","Effect":"Allow","Action":"ec2:CreateVpc","Resource":"arn:aws:ec2:${aws_region}:${account_id}:vpc/*","Condition":{"StringEquals":{"aws:RequestTag/Project":"${project_name}","aws:RequestTag/Environment":"${environment}","aws:RequestTag/ManagedBy":"Terraform"},"ForAllValues:StringEquals":{"aws:TagKeys":["Project","Environment","ManagedBy","Repository","Name"]}}},{"Sid":"TagVpcDuringCreation","Effect":"Allow","Action":"ec2:CreateTags","Resource":"arn:aws:ec2:${aws_region}:${account_id}:vpc/*","Condition":{"StringEquals":{"ec2:CreateAction":"CreateVpc","aws:RequestTag/Project":"${project_name}","aws:RequestTag/Environment":"${environment}","aws:RequestTag/ManagedBy":"Terraform"},"ForAllValues:StringEquals":{"aws:TagKeys":["Project","Environment","ManagedBy","Repository","Name"]}}},{"Sid":"CreateTaggedDevelopmentSubnet","Effect":"Allow","Action":"ec2:CreateSubnet","Resource":"arn:aws:ec2:${aws_region}:${account_id}:subnet/*","Condition":{"StringEquals":{"aws:RequestTag/Project":"${project_name}","aws:RequestTag/Environment":"${environment}","aws:RequestTag/ManagedBy":"Terraform"},"ForAllValues:StringEquals":{"aws:TagKeys":["Project","Environment","ManagedBy","Repository","Name","Tier"]}}},{"Sid":"UseDevelopmentVpcForSubnet","Effect":"Allow","Action":"ec2:CreateSubnet","Resource":"arn:aws:ec2:${aws_region}:${account_id}:vpc/${vpc_id}","Condition":{"StringEquals":{"aws:ResourceTag/Project":"${project_name}","aws:ResourceTag/Environment":"${environment}"}}},{"Sid":"TagSubnetDuringCreation","Effect":"Allow","Action":"ec2:CreateTags","Resource":"arn:aws:ec2:${aws_region}:${account_id}:subnet/*","Condition":{"StringEquals":{"ec2:CreateAction":"CreateSubnet","aws:RequestTag/Project":"${project_name}","aws:RequestTag/Environment":"${environment}","aws:RequestTag/ManagedBy":"Terraform"},"ForAllValues:StringEquals":{"aws:TagKeys":["Project","Environment","ManagedBy","Repository","Name","Tier"]}}},{"Sid":"CreateTaggedDevelopmentRouteTable","Effect":"Allow","Action":"ec2:CreateRouteTable","Resource":"arn:aws:ec2:${aws_region}:${account_id}:route-table/*","Condition":{"StringEquals":{"aws:RequestTag/Project":"${project_name}","aws:RequestTag/Environment":"${environment}","aws:RequestTag/ManagedBy":"Terraform"},"ForAllValues:StringEquals":{"aws:TagKeys":["Project","Environment","ManagedBy","Repository","Name"]}}},{"Sid":"UseDevelopmentVpcForRouteTable","Effect":"Allow","Action":"ec2:CreateRouteTable","Resource":"arn:aws:ec2:${aws_region}:${account_id}:vpc/${vpc_id}","Condition":{"StringEquals":{"aws:ResourceTag/Project":"${project_name}","aws:ResourceTag/Environment":"${environment}"}}},{"Sid":"TagRouteTableDuringCreation","Effect":"Allow","Action":"ec2:CreateTags","Resource":"arn:aws:ec2:${aws_region}:${account_id}:route-table/*","Condition":{"StringEquals":{"ec2:CreateAction":"CreateRouteTable","aws:RequestTag/Project":"${project_name}","aws:RequestTag/Environment":"${environment}","aws:RequestTag/ManagedBy":"Terraform"},"ForAllValues:StringEquals":{"aws:TagKeys":["Project","Environment","ManagedBy","Repository","Name"]}}},{"Sid":"ManageDevelopmentRoutes","Effect":"Allow","Action":["ec2:CreateRoute","ec2:ReplaceRoute","ec2:DeleteRoute"],"Resource":"arn:aws:ec2:${aws_region}:${account_id}:route-table/*","Condition":{"StringEquals":{"aws:ResourceTag/Project":"${project_name}","aws:ResourceTag/Environment":"${environment}"}}},{"Sid":"ManageDevelopmentRouteTableAssociations","Effect":"Allow","Action":["ec2:AssociateRouteTable","ec2:DisassociateRouteTable","ec2:ReplaceRouteTableAssociation"],"Resource":["arn:aws:ec2:${aws_region}:${account_id}:route-table/*","arn:aws:ec2:${aws_region}:${account_id}:subnet/*"],"Condition":{"StringEquals":{"aws:ResourceTag/Project":"${project_name}","aws:ResourceTag/Environment":"${environment}"}}}]}
