{"Version":"2012-10-17","Statement":[{"Sid":"UseApprovedAmazonLinuxAmi","Effect":"Allow","Action":"ec2:RunInstances","Resource":"arn:aws:ec2:${aws_region}::image/${approved_ami_id}"},{"Sid":"UseApprovedPrivateSubnet","Effect":"Allow","Action":"ec2:RunInstances","Resource":"arn:aws:ec2:${aws_region}:${account_id}:subnet/${private_subnet_id}"},{"Sid":"UseApprovedWorkloadSecurityGroup","Effect":"Allow","Action":"ec2:RunInstances","Resource":"arn:aws:ec2:${aws_region}:${account_id}:security-group/${workload_security_group_id}"},{"Sid":"CreatePrivateNetworkInterface","Effect":"Allow","Action":"ec2:RunInstances","Resource":"arn:aws:ec2:${aws_region}:${account_id}:network-interface/*","Condition":{"ArnEquals":{"ec2:Subnet":"arn:aws:ec2:${aws_region}:${account_id}:subnet/${private_subnet_id}"},"BoolIfExists":{"ec2:AssociatePublicIpAddress":"false"}}},{"Sid":"LaunchTaggedT3MicroInstance","Effect":"Allow","Action":"ec2:RunInstances","Resource":"arn:aws:ec2:${aws_region}:${account_id}:instance/*","Condition":{"StringEquals":{"ec2:InstanceType":"t3.micro","ec2:MetadataHttpTokens":"required","aws:RequestTag/Project":"${project_name}","aws:RequestTag/Environment":"${environment}","aws:RequestTag/ManagedBy":"Terraform","aws:RequestTag/Repository":"${repository_name}"},"ForAllValues:StringEquals":{"aws:TagKeys":["Project","Environment","ManagedBy","Repository","Name"]}}},{"Sid":"CreateEncryptedGp3DevelopmentVolume","Effect":"Allow","Action":"ec2:RunInstances","Resource":"arn:aws:ec2:${aws_region}:${account_id}:volume/*","Condition":{"StringEquals":{"ec2:VolumeType":"gp3","aws:RequestTag/Project":"${project_name}","aws:RequestTag/Environment":"${environment}","aws:RequestTag/ManagedBy":"Terraform","aws:RequestTag/Repository":"${repository_name}"},"Bool":{"ec2:Encrypted":"true"},"NumericLessThanEquals":{"ec2:VolumeSize":"15"},"ForAllValues:StringEquals":{"aws:TagKeys":["Project","Environment","ManagedBy","Repository","Name"]}}},{"Sid":"TagResourcesDuringRunInstances","Effect":"Allow","Action":"ec2:CreateTags","Resource":["arn:aws:ec2:${aws_region}:${account_id}:instance/*","arn:aws:ec2:${aws_region}:${account_id}:volume/*"],"Condition":{"StringEquals":{"ec2:CreateAction":"RunInstances","aws:RequestTag/Project":"${project_name}","aws:RequestTag/Environment":"${environment}","aws:RequestTag/ManagedBy":"Terraform","aws:RequestTag/Repository":"${repository_name}"},"ForAllValues:StringEquals":{"aws:TagKeys":["Project","Environment","ManagedBy","Repository","Name"]}}},{"Sid":"ManageDevelopmentInstanceLifecycle","Effect":"Allow","Action":["ec2:StartInstances","ec2:StopInstances","ec2:TerminateInstances"],"Resource":"arn:aws:ec2:${aws_region}:${account_id}:instance/*","Condition":{"StringEquals":{"aws:ResourceTag/Project":"${project_name}","aws:ResourceTag/Environment":"${environment}","aws:ResourceTag/ManagedBy":"Terraform"}}},{"Sid":"CreateTaggedDevelopmentEice","Effect":"Allow","Action":"ec2:CreateInstanceConnectEndpoint","Resource":"arn:aws:ec2:${aws_region}:${account_id}:instance-connect-endpoint/*","Condition":{"StringEquals":{"ec2:SubnetID":"${private_subnet_id}","aws:RequestTag/Project":"${project_name}","aws:RequestTag/Environment":"${environment}","aws:RequestTag/ManagedBy":"Terraform","aws:RequestTag/Repository":"${repository_name}"},"ForAllValues:StringEquals":{"aws:TagKeys":["Project","Environment","ManagedBy","Repository","Name"]}}},{"Sid":"UsePrivateSubnetForEice","Effect":"Allow","Action":"ec2:CreateInstanceConnectEndpoint","Resource":"arn:aws:ec2:${aws_region}:${account_id}:subnet/${private_subnet_id}","Condition":{"StringEquals":{"aws:ResourceTag/Project":"${project_name}","aws:ResourceTag/Environment":"${environment}"}}},{"Sid":"UseApprovedEiceSecurityGroup","Effect":"Allow","Action":"ec2:CreateInstanceConnectEndpoint","Resource":"arn:aws:ec2:${aws_region}:${account_id}:security-group/${eice_security_group_id}","Condition":{"StringEquals":{"aws:ResourceTag/Project":"${project_name}","aws:ResourceTag/Environment":"${environment}"}}},{"Sid":"CreateNetworkInterfaceForEice","Effect":"Allow","Action":"ec2:CreateNetworkInterface","Resource":["arn:aws:ec2:${aws_region}:${account_id}:network-interface/*","arn:aws:ec2:${aws_region}:${account_id}:subnet/${private_subnet_id}","arn:aws:ec2:${aws_region}:${account_id}:security-group/${eice_security_group_id}"]},{"Sid":"TagEiceDuringCreation","Effect":"Allow","Action":"ec2:CreateTags","Resource":"arn:aws:ec2:${aws_region}:${account_id}:instance-connect-endpoint/*","Condition":{"StringEquals":{"ec2:CreateAction":"CreateInstanceConnectEndpoint","aws:RequestTag/Project":"${project_name}","aws:RequestTag/Environment":"${environment}","aws:RequestTag/ManagedBy":"Terraform","aws:RequestTag/Repository":"${repository_name}"},"ForAllValues:StringEquals":{"aws:TagKeys":["Project","Environment","ManagedBy","Repository","Name"]}}},{"Sid":"ModifyDevelopmentEice","Effect":"Allow","Action":"ec2:ModifyInstanceConnectEndpoint","Resource":["arn:aws:ec2:${aws_region}:${account_id}:instance-connect-endpoint/*","arn:aws:ec2:${aws_region}:${account_id}:security-group/${eice_security_group_id}"],"Condition":{"StringEquals":{"aws:ResourceTag/Project":"${project_name}","aws:ResourceTag/Environment":"${environment}"}}},{"Sid":"DeleteDevelopmentEice","Effect":"Allow","Action":"ec2:DeleteInstanceConnectEndpoint","Resource":"arn:aws:ec2:${aws_region}:${account_id}:instance-connect-endpoint/*","Condition":{"StringEquals":{"aws:ResourceTag/Project":"${project_name}","aws:ResourceTag/Environment":"${environment}"}}},{"Sid":"DescribeEice","Effect":"Allow","Action":"ec2:DescribeInstanceConnectEndpoints","Resource":"*"}]}
