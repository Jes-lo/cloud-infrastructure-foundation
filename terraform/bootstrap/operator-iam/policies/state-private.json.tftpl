{"Version":"2012-10-17","Statement":[{"Sid":"ListDevelopmentStatePath","Effect":"Allow","Action":"s3:ListBucket","Resource":"arn:aws:s3:::${state_bucket_name}","Condition":{"StringLike":{"s3:prefix":["environments/${environment}/*"]}}},{"Sid":"ReadWriteDevelopmentState","Effect":"Allow","Action":["s3:GetObject","s3:PutObject"],"Resource":"arn:aws:s3:::${state_bucket_name}/environments/${environment}/terraform.tfstate"},{"Sid":"ManageDevelopmentStateLock","Effect":"Allow","Action":["s3:GetObject","s3:PutObject","s3:DeleteObject"],"Resource":"arn:aws:s3:::${state_bucket_name}/environments/${environment}/terraform.tfstate.tflock"},{"Sid":"ReadTerraformEc2State","Effect":"Allow","Action":["ec2:DescribeAccountAttributes","ec2:DescribeAddresses","ec2:DescribeAvailabilityZones","ec2:DescribeCapacityReservations","ec2:DescribeHosts","ec2:DescribeImages","ec2:DescribeInstanceAttribute","ec2:DescribeInstanceConnectEndpoints","ec2:DescribeInstanceCreditSpecifications","ec2:DescribeInstanceStatus","ec2:DescribeInstanceTypes","ec2:DescribeInstances","ec2:DescribeInternetGateways","ec2:DescribeKeyPairs","ec2:DescribeLaunchTemplates","ec2:DescribeNetworkAcls","ec2:DescribeNetworkInterfaces","ec2:DescribePlacementGroups","ec2:DescribeRegions","ec2:DescribeReplaceRootVolumeTasks","ec2:DescribeRouteTables","ec2:DescribeSecurityGroupRules","ec2:DescribeSecurityGroups","ec2:DescribeSnapshots","ec2:DescribeSubnets","ec2:DescribeTags","ec2:DescribeVolumeStatus","ec2:DescribeVolumes","ec2:DescribeVpcAttribute","ec2:DescribeVpcs"],"Resource":"*"},{"Sid":"ReadAmazonLinuxPublicAmiParameter","Effect":"Allow","Action":"ssm:GetParameter","Resource":"arn:aws:ssm:${aws_region}::parameter/aws/service/ami-amazon-linux-latest/*"},{"Sid":"OpenProjectSshTunnel","Effect":"Allow","Action":"ec2-instance-connect:OpenTunnel","Resource":"arn:aws:ec2:${aws_region}:${account_id}:instance-connect-endpoint/*","Condition":{"StringEquals":{"aws:ResourceTag/Project":"${project_name}","aws:ResourceTag/Environment":"${environment}"},"NumericEquals":{"ec2-instance-connect:remotePort":"22"},"IpAddress":{"ec2-instance-connect:privateIpAddress":"${private_subnet_cidr}"},"NumericLessThanEquals":{"ec2-instance-connect:maxTunnelDuration":"3600"}}},{"Sid":"SendProjectSshPublicKey","Effect":"Allow","Action":"ec2-instance-connect:SendSSHPublicKey","Resource":"arn:aws:ec2:${aws_region}:${account_id}:instance/*","Condition":{"StringEquals":{"aws:ResourceTag/Project":"${project_name}","aws:ResourceTag/Environment":"${environment}","ec2:osuser":"ec2-user"}}},{"Sid":"DescribePrivateAccessResources","Effect":"Allow","Action":["ec2:DescribeInstances","ec2:DescribeInstanceConnectEndpoints"],"Resource":"*"}]}
