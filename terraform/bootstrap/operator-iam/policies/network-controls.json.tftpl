{"Version":"2012-10-17","Statement":[{"Sid":"CreateTaggedDevelopmentSecurityGroup","Effect":"Allow","Action":"ec2:CreateSecurityGroup","Resource":"arn:aws:ec2:${aws_region}:${account_id}:security-group/*","Condition":{"StringEquals":{"aws:RequestTag/Project":"${project_name}","aws:RequestTag/Environment":"${environment}","aws:RequestTag/ManagedBy":"Terraform"},"ForAllValues:StringEquals":{"aws:TagKeys":["Project","Environment","ManagedBy","Repository","Name"]}}},{"Sid":"UseDevelopmentVpcForSecurityGroup","Effect":"Allow","Action":"ec2:CreateSecurityGroup","Resource":"arn:aws:ec2:${aws_region}:${account_id}:vpc/${vpc_id}","Condition":{"StringEquals":{"aws:ResourceTag/Project":"${project_name}","aws:ResourceTag/Environment":"${environment}"}}},{"Sid":"TagSecurityGroupDuringCreation","Effect":"Allow","Action":"ec2:CreateTags","Resource":"arn:aws:ec2:${aws_region}:${account_id}:security-group/*","Condition":{"StringEquals":{"ec2:CreateAction":"CreateSecurityGroup","aws:RequestTag/Project":"${project_name}","aws:RequestTag/Environment":"${environment}","aws:RequestTag/ManagedBy":"Terraform"},"ForAllValues:StringEquals":{"aws:TagKeys":["Project","Environment","ManagedBy","Repository","Name"]}}},{"Sid":"ManageRulesOnDevelopmentSecurityGroups","Effect":"Allow","Action":["ec2:AuthorizeSecurityGroupIngress","ec2:AuthorizeSecurityGroupEgress","ec2:RevokeSecurityGroupIngress","ec2:RevokeSecurityGroupEgress"],"Resource":"arn:aws:ec2:${aws_region}:${account_id}:security-group/*","Condition":{"StringEquals":{"aws:ResourceTag/Project":"${project_name}","aws:ResourceTag/Environment":"${environment}"}}},{"Sid":"CreateTaggedDevelopmentSecurityGroupRules","Effect":"Allow","Action":["ec2:AuthorizeSecurityGroupIngress","ec2:AuthorizeSecurityGroupEgress"],"Resource":"arn:aws:ec2:${aws_region}:${account_id}:security-group-rule/*","Condition":{"StringEquals":{"aws:RequestTag/Project":"${project_name}","aws:RequestTag/Environment":"${environment}","aws:RequestTag/ManagedBy":"Terraform","aws:RequestTag/Repository":"${repository_name}"},"ForAllValues:StringEquals":{"aws:TagKeys":["Project","Environment","ManagedBy","Repository"]}}},{"Sid":"TagDevelopmentSecurityGroupRules","Effect":"Allow","Action":"ec2:CreateTags","Resource":"arn:aws:ec2:${aws_region}:${account_id}:security-group-rule/*","Condition":{"StringEquals":{"aws:RequestTag/Project":"${project_name}","aws:RequestTag/Environment":"${environment}","aws:RequestTag/ManagedBy":"Terraform","aws:RequestTag/Repository":"${repository_name}"},"ForAllValues:StringEquals":{"aws:TagKeys":["Project","Environment","ManagedBy","Repository"]},"ForAnyValue:StringEquals":{"ec2:CreateAction":["AuthorizeSecurityGroupIngress","AuthorizeSecurityGroupEgress"]}}},{"Sid":"CreateTaggedDevelopmentInternetGateway","Effect":"Allow","Action":"ec2:CreateInternetGateway","Resource":"arn:aws:ec2:${aws_region}:${account_id}:internet-gateway/*","Condition":{"StringEquals":{"aws:RequestTag/Project":"${project_name}","aws:RequestTag/Environment":"${environment}","aws:RequestTag/ManagedBy":"Terraform"},"ForAllValues:StringEquals":{"aws:TagKeys":["Project","Environment","ManagedBy","Repository","Name"]}}},{"Sid":"TagInternetGatewayDuringCreation","Effect":"Allow","Action":"ec2:CreateTags","Resource":"arn:aws:ec2:${aws_region}:${account_id}:internet-gateway/*","Condition":{"StringEquals":{"ec2:CreateAction":"CreateInternetGateway","aws:RequestTag/Project":"${project_name}","aws:RequestTag/Environment":"${environment}","aws:RequestTag/ManagedBy":"Terraform"},"ForAllValues:StringEquals":{"aws:TagKeys":["Project","Environment","ManagedBy","Repository","Name"]}}},{"Sid":"AttachDevelopmentInternetGateway","Effect":"Allow","Action":"ec2:AttachInternetGateway","Resource":["arn:aws:ec2:${aws_region}:${account_id}:internet-gateway/*","arn:aws:ec2:${aws_region}:${account_id}:vpc/${vpc_id}"],"Condition":{"StringEquals":{"aws:ResourceTag/Project":"${project_name}","aws:ResourceTag/Environment":"${environment}"}}},{"Sid":"ModifyDevelopmentVpcAttributes","Effect":"Allow","Action":"ec2:ModifyVpcAttribute","Resource":"arn:aws:ec2:${aws_region}:${account_id}:vpc/*","Condition":{"StringEquals":{"aws:ResourceTag/Project":"${project_name}","aws:ResourceTag/Environment":"${environment}"}}},{"Sid":"ModifyDevelopmentSubnetAttributes","Effect":"Allow","Action":"ec2:ModifySubnetAttribute","Resource":"arn:aws:ec2:${aws_region}:${account_id}:subnet/*","Condition":{"StringEquals":{"aws:ResourceTag/Project":"${project_name}","aws:ResourceTag/Environment":"${environment}"}}},{"Sid":"DetachDevelopmentInternetGateway","Effect":"Allow","Action":"ec2:DetachInternetGateway","Resource":["arn:aws:ec2:${aws_region}:${account_id}:internet-gateway/*","arn:aws:ec2:${aws_region}:${account_id}:vpc/*"],"Condition":{"StringEquals":{"aws:ResourceTag/Project":"${project_name}","aws:ResourceTag/Environment":"${environment}"}}},{"Sid":"DeleteDevelopmentNetworkResources","Effect":"Allow","Action":["ec2:DeleteVpc","ec2:DeleteSubnet","ec2:DeleteRouteTable","ec2:DeleteSecurityGroup","ec2:DeleteInternetGateway"],"Resource":["arn:aws:ec2:${aws_region}:${account_id}:vpc/*","arn:aws:ec2:${aws_region}:${account_id}:subnet/*","arn:aws:ec2:${aws_region}:${account_id}:route-table/*","arn:aws:ec2:${aws_region}:${account_id}:security-group/*","arn:aws:ec2:${aws_region}:${account_id}:internet-gateway/*"],"Condition":{"StringEquals":{"aws:ResourceTag/Project":"${project_name}","aws:ResourceTag/Environment":"${environment}"}}}]}
